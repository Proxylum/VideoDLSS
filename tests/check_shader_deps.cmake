# Every file a shader includes is an input of the rule that compiles it (PR-8): the NR resolve takes its edited colour from
# NrEdited.hlsli, and an include missing from DEPENDS left the embedded bytecode stale after an edit of it - the class of the
# stale-object incident. For each generated shader header (gen/**/*_{cs,vs,ps}.h) the check reads the .hlsl among the rule's
# inputs, its `#include "..."` lines, and requires each included file among the inputs.
#   cmake -DBUILD_DIR=<build dir> [-DNINJA=<ninja.exe>] -P tests/check_shader_deps.cmake
if(NOT BUILD_DIR)
  message(FATAL_ERROR "BUILD_DIR is required")
endif()
if(NOT NINJA)
  find_program(NINJA ninja REQUIRED)
endif()
execute_process(COMMAND "${NINJA}" -C "${BUILD_DIR}" -t targets all OUTPUT_VARIABLE targets RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "ninja -t targets failed (${rc}): ${err}")
endif()
string(REGEX MATCHALL "[^\n]*gen/[^\n:]*_(cs|vs|ps)\\.h: CUSTOM_COMMAND" headers "${targets}")
list(LENGTH headers total)
if(total EQUAL 0)
  message(FATAL_ERROR "no generated shader headers among the ninja targets of ${BUILD_DIR}")
endif()
set(bad "")
set(checked 0)
set(nheaders 0)
foreach(entry IN LISTS headers)
  string(REGEX REPLACE ": CUSTOM_COMMAND$" "" header "${entry}")
  if(header MATCHES "^[A-Za-z]:/")
    continue()  # ninja lists the outputs under both names: the build-relative one is enough
  endif()
  math(EXPR nheaders "${nheaders} + 1")
  execute_process(COMMAND "${NINJA}" -C "${BUILD_DIR}" -t query "${header}" OUTPUT_VARIABLE query RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "ninja -t query ${header} failed (${rc})")
  endif()
  # the rule's inputs: the lines between "input:" and "outputs:", one path each
  string(REGEX REPLACE "outputs:.*$" "" inputs "${query}")
  string(REGEX MATCHALL "[^\n\t |]+\\.hlsl" sources "${inputs}")
  foreach(src IN LISTS sources)
    if(NOT EXISTS "${src}")
      continue()
    endif()
    file(STRINGS "${src}" includes REGEX "^[ \t]*#[ \t]*include[ \t]+\"")
    foreach(line IN LISTS includes)
      string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]+\"([^\"]+)\".*$" "\\1" inc "${line}")
      get_filename_component(name "${inc}" NAME)
      math(EXPR checked "${checked} + 1")
      if(NOT inputs MATCHES "[/\\\\]${name}[\n\r ]")
        list(APPEND bad "${header}: ${src} includes \"${inc}\", which is not an input of the rule")
      endif()
    endforeach()
  endforeach()
endforeach()
list(LENGTH bad nbad)
if(nbad GREATER 0)
  string(REPLACE ";" "\n  " shown "${bad}")
  message(FATAL_ERROR "${nbad} shader include(s) missing from DEPENDS - an edit of them would not rebuild the bytecode:\n  ${shown}\n"
    "Fix: list the file in DEPENDS of dlssvid_compile_shader / dlssvid_compile_shader_ex (core/CMakeLists.txt; *.hlsli are globbed).")
endif()
message(STATUS "every shader include is an input of its rule (${nheaders} shader headers, ${checked} includes)")
