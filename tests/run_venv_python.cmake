# Runs a Python test with the models/export virtual environment (torch, onnx): the one of DLSSVID_MODELS_DIR (the
# runner's shared models tree) or of this checkout. Without one the test reports "venv not found" (SKIP_REGULAR_EXPRESSION).
#   cmake -DSOURCE_DIR=<checkout> -DSCRIPT=<test.py> -P tests/run_venv_python.cmake
set(_candidates)
if(DEFINED ENV{DLSSVID_MODELS_DIR})
  file(TO_CMAKE_PATH "$ENV{DLSSVID_MODELS_DIR}" _models)
  list(APPEND _candidates "${_models}/export/.venv/Scripts/python.exe")
endif()
list(APPEND _candidates "${SOURCE_DIR}/models/export/.venv/Scripts/python.exe")
set(_python "")
foreach(_c IN LISTS _candidates)
  if(EXISTS "${_c}")
    set(_python "${_c}")
    break()
  endif()
endforeach()
if(NOT _python)
  message("venv not found: create models/export/.venv (models/export/README.md)")
  return()
endif()
execute_process(COMMAND "${_python}" -I "${SCRIPT}" RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "${SCRIPT} failed (${_rc})")
endif()
