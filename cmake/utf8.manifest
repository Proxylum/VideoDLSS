<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- UTF-8 as the process code page (Windows 10 1903+): argv, std::string paths and path::string() are UTF-8 in every
     executable of the project. dlssvid_utf8_code_page() in CMakeLists.txt merges it into each one (TASK-0066). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
